#!/usr/bin/env bash

#
# aix-user: a public-domain PoC/attempt to run 32-bit AIX binaries
# on Linux via Unicorn, same idea as 'qemu-user', but for AIX+PPC
# Made by Theldus, 2025-2026
#

CURDIR="$( cd "$(dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
ROOTDIR="${CURDIR}/../../"
AIX_USER="${ROOTDIR}/aix-user"

cd "${CURDIR}"

any_error=0
test_num=0

function run_test() {
	test_num=$((test_num+1))
	printf "  getdirent64 #${test_num}... "

	# Run AIX version via emulator
	"${AIX_USER}" test_getdirent &> "out_aix"
	aix_rc=$?

	# Run Linux reference
	./reference &> "out_linux"
	linux_rc=$?

	# Compare return codes
	if [ "${aix_rc}" -ne "${linux_rc}" ]; then
		echo "FAIL (rc: ${aix_rc} vs ${linux_rc})"
		any_error=1
		return
	fi

	# Compare outputs
	if ! diff -q "out_aix" "out_linux" &>/dev/null; then
		echo "FAIL (output mismatch)"
		diff -u "out_linux" "out_aix"
		any_error=1
		return
	fi

	rm -f out_aix out_linux
	echo "OK"
}

# Create folder structure
pushd . &>/dev/null
cd "${CURDIR}/"
mkdir -p testdir
touch testdir/a testdir/b testdir/c testdir/longfilename.txt
popd &>/dev/null

# Test AIX vs Linux
run_test

# Cleanup
pushd . &>/dev/null
cd "${CURDIR}/"
rm -f testdir/a testdir/b testdir/c testdir/longfilename.txt
rm -rf ./testdir
popd &>/dev/null

exit "${any_error}"
